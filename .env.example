# Documentation only: export this in your shell; M0 does not auto-load .env files.
GIRLFRAME_DATABASE_URL=sqlite:///./var/girlframe.db
# M1 read-only bot: DiscordBot must be supplied securely by the environment.
# Never place its real value in this example. No AI key is used.
# GIRLFRAME_DISCORD_CONFIG=/absolute/private/path/to/policy.json
# Optional: absolute path to an explicitly bootstrapped disposable engine runtime.
# GIRLFRAME_ENGINE_SANDBOX=/absolute/private/path/runtime/dev
